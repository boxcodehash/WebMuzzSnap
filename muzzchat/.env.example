# Copia este archivo a .env.local. No subas secretos.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-muzzchat.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-muzzchat
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_EMULATORS=true

# Identificador público de WalletConnect / Reown. Si está vacío, el botón no conecta.
VITE_WALLETCONNECT_PROJECT_ID=
