# Copia a functions/.env. El emulador de Firebase carga ese archivo.
# NUNCA uses el proyecto de Firebase "pulsari".

# RPC de Ethereum mainnet. Sin esto, el saldo real no se puede leer.
ETH_RPC_URL=https://your-ethereum-mainnet-rpc.example

# Opcional. Este es el contrato por defecto.
MUZZ_TOKEN_ADDRESS=0xef3dAa5fDa8Ad7aabFF4658f1F78061fd626B8f0

# Tokens enteros mínimos. El umbral en wei es MIN_MUZZ_WHOLE * 10^18.
MIN_MUZZ_WHOLE=10000000

# 32 bytes en base64. Genera una clave nueva para cualquier despliegue real:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# "replace-me" solo funciona dentro del emulador.
SERVER_WRAP_KEY=replace-me

# Dominios SIWE permitidos, separados por coma (incluye el puerto si lo hay).
# Vacío: el emulador acepta cualquiera. En producción hay que definirlo.
SIWE_ALLOWED_DOMAINS=

# SOLO emulador (FUNCTIONS_EMULATOR=true). Si existe, no se llama a la RPC para el saldo.
# 10_000_000 * 10^18:
# MUZZ_DEV_BALANCE_WEI=10000000000000000000000000
