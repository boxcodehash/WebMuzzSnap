    "firebase": "^11.6.0",
    "libsodium-wrappers": "0.7.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "siwe": "^3.0.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^14.2.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.9"
