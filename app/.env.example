# Optional override. The public MuzzSnap id is already in www/config.public.js.
# Do not commit .env. Free project: https://cloud.reown.com — see DEPLOY.md.
# WALLETCONNECT_PROJECT_ID=

# Public login page opened inside the wallet. The APK origin is https://localhost
# and wallets cannot load it. Default in www/config.public.js is
# https://muzzsnap-app.vercel.app — set this only to override that URL.
# APP_PUBLIC_URL=https://muzzsnap-app.vercel.app

# Preview UI without Firebase (sample chat). 1 = on. Leave empty for a real build.
# MUZZ_PREVIEW=1

# Only if this preview should also reach real Cloud Functions (?login=1).
# MUZZ_FUNCTIONS_BASE=https://us-central1-YOUR_PROJECT.cloudfunctions.net
# MUZZ_MIN_MUZZ=10000000

# Only to point the client at a Firebase project other than the public pulsari config.
# Set all six, or none.
# MUZZ_FIREBASE_API_KEY=
# MUZZ_FIREBASE_AUTH_DOMAIN=
# MUZZ_FIREBASE_PROJECT_ID=
# MUZZ_FIREBASE_STORAGE_BUCKET=
# MUZZ_FIREBASE_MESSAGING_SENDER_ID=
# MUZZ_FIREBASE_APP_ID=
# MUZZ_FIREBASE_DATABASE_URL=

# Closed-app private alerts. These are Vercel server variables for the
# muzzsnap-app project (Root Directory app). They are not read by the client
# build. Do not commit the values. FCM is free on the Spark plan. This does
# not use Cloud Functions and does not need the Blaze plan.
#
# FIREBASE_SERVICE_ACCOUNT=
#   Already set on the Vercel project muzzsnap-app (Production and Preview).
#   /api/notify reads process.env.FIREBASE_SERVICE_ACCOUNT. Never put the JSON
#   in the client, the repo, or www.zip.
# FIREBASE_VAPID_KEY=
#   Optional. The public key is already in the client and /api/push-config.
#   Set this only to override it. The private key stays in Firebase.
# FIREBASE_DATABASE_URL=https://pulsari-default-rtdb.firebaseio.com
