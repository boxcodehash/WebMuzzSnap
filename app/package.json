{
  "name": "muzzsnap-app",
  "private": true,
  "version": "1.0.0",
  "description": "App MuzzSnap: chat y privado E2EE para holders de MUZZ",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/sync-shared.mjs && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/sync-shared.mjs && node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-muzz \"node --test test/rules.test.js\"",
    "cap:sync": "npm run build && cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "esbuild": "^0.25.9",
    "firebase-tools": "^14.17.0"
  }
}
